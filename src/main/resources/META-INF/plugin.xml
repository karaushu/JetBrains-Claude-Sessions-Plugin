<idea-plugin>
    <id>dev.andy.claudesessions</id>
    <name>Sessions for Claude Code</name>
    <vendor url="https://github.com/karaushu/JetBrains-Claude-Sessions-Plugin">karaushu</vendor>

    <description><![CDATA[
        <p>Lists your Claude Code sessions in a tool window, shows which are running and
        which are waiting for your input, and resumes any of them as a tab in the main
        editor area.</p>

        <ul>
          <li>Live status per session: a spinner while Claude is working, an attention icon
              when it wants input, and a badge on the stripe so you notice while the tool
              window is collapsed.</li>
          <li>System notifications when a turn ends or Claude needs an answer, each
              switchable on its own.</li>
          <li>Sessions grouped by project, with git worktrees listed under the project they
              were started for.</li>
          <li>Usage limits in the toolbar, read from the figures Claude already caches
              locally rather than from the API.</li>
        </ul>

        <p><b>Requires <a href="https://claude.com/claude-code">Claude Code</a> to be
        installed</b> and on the IDE's PATH. Everything stays on your machine: the plugin
        reads <code>~/.claude</code>, runs <code>claude</code> as a subprocess, and sends
        nothing anywhere. Enabling status hooks — which is optional, and off until you ask
        for it — adds entries to <code>~/.claude/settings.json</code>, with a timestamped
        backup written first.</p>

        <p><i>Unofficial. Not affiliated with, endorsed by, or sponsored by Anthropic.
        Claude and Claude Code are trademarks of Anthropic, PBC.</i></p>
    ]]></description>

    <!-- JavaScript is not recognised as a module, so WebStorm plugins must state this explicitly. -->
    <depends>com.intellij.modules.platform</depends>

    <!--
      The reworked Terminal API (TerminalToolWindowTabsManager) lives in the
      intellij.terminal.frontend content module, which has its own classloader.
      Depending on the terminal plugin alone is not enough.
    -->
    <dependencies>
        <plugin id="org.jetbrains.plugins.terminal"/>
        <module name="intellij.terminal.frontend"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Claude Sessions"
                    anchor="left"
                    canCloseContents="false"
                    factoryClass="dev.andy.claudesessions.ui.ClaudeSessionsToolWindowFactory"
                    icon="dev.andy.claudesessions.ClaudeSessionsIcons.ToolWindow"/>

        <iconMapper mappingFile="ClaudeSessionsIconMappings.json"/>

        <notificationGroup id="Claude Sessions" displayType="BALLOON"/>

        <!--
          Separate from the group above so turn-end balloons can be turned down without
          also silencing an archive's Undo. The OS notification is posted independently
          and is gated by the platform on the IDE not being the active application.
        -->
        <notificationGroup id="Claude Session Status" displayType="BALLOON"/>

        <!-- Starts watching hook events without waiting for the tool window to be opened. -->
        <postStartupActivity
            implementation="dev.andy.claudesessions.notify.SessionNotifierStartup"/>

        <!-- Watches for the agent's answers to review notes, diff open or not. -->
        <postStartupActivity implementation="dev.andy.claudesessions.review.ReviewStartup"/>

        <applicationConfigurable
            parentId="tools"
            id="dev.andy.claudesessions.settings"
            displayName="Claude Sessions"
            instance="dev.andy.claudesessions.settings.ClaudeSessionsConfigurable"/>

        <!-- Hosts a session's terminal as a tab in the main editor area. -->
        <fileEditorProvider
            implementation="dev.andy.claudesessions.terminal.ClaudeTerminalFileEditorProvider"/>
        <!-- Keeps the editor tab limit from silently evicting a live session. -->
        <editorAutoClosingHandler
            implementation="dev.andy.claudesessions.terminal.ClaudeTerminalAutoClosingHandler"/>

        <!-- Adds the review gutter to every text diff viewer. Dynamic, so no restart to install. -->
        <diff.DiffExtension implementation="dev.andy.claudesessions.review.ReviewDiffExtension"/>
    </extensions>

    <!--
      The only listener the plugin registers. Declared here rather than subscribed from a
      service constructor so the platform instantiates it lazily, on the first selection change.
    -->
    <projectListeners>
        <listener class="dev.andy.claudesessions.terminal.ClaudeTabFocusTracker"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>

    <actions>
        <group id="ClaudeSessions.Toolbar">
            <action id="ClaudeSessions.NewSession"
                    class="dev.andy.claudesessions.actions.NewSessionAction"
                    text="New Claude Session"
                    description="Start a new Claude Code session in an editor tab"
                    icon="AllIcons.General.Add"/>
            <action id="ClaudeSessions.Refresh"
                    class="dev.andy.claudesessions.actions.RefreshSessionsAction"
                    text="Refresh"
                    description="Re-scan Claude Code session transcripts"
                    icon="AllIcons.Actions.Refresh"/>
            <action id="ClaudeSessions.ToggleScope"
                    class="dev.andy.claudesessions.actions.ToggleScopeAction"
                    text="Show Sessions from All Projects"
                    description="Include sessions whose working directory is outside this project"
                    icon="AllIcons.Actions.ShowAsTree"/>
            <separator/>
            <!--
              Also placed on the diff toolbar by ReviewDiffExtension. Here as well, because a
              narrow diff pane folds it into the overflow menu, and because the user may have
              closed the diff while notes are still waiting to go.
            -->
            <!--
              Two buttons that read as one split button: the label sends, the arrow retargets.
              The icon and the text here are not decoration — a text-only button is created
              before the first update() has anything to measure, and a zero-width button never
              grows back.
            -->
            <action id="ClaudeSessions.SendReviewNotes"
                    class="dev.andy.claudesessions.review.SendReviewNotesAction"
                    text="Send Review Notes to Claude"
                    description="Send the notes written in diff gutters to a Claude Code session"
                    icon="dev.andy.claudesessions.ClaudeSessionsIcons.SessionLive"/>
            <action id="ClaudeSessions.PickReviewTarget"
                    class="dev.andy.claudesessions.review.PickReviewTargetAction"
                    text="Send Review Notes To…"
                    description="Choose which Claude session the notes go to"
                    icon="AllIcons.General.ChevronDown"/>
            <action id="ClaudeSessions.UsageLimits"
                    class="dev.andy.claudesessions.actions.UsageLimitsAction"
                    text="Usage Limits"
                    description="Claude usage limits, read from Claude's own cache"/>
        </group>

        <!-- Rendered as a separate toolbar pinned to the right edge; see ClaudeSessionsPanel. -->
        <group id="ClaudeSessions.Toolbar.Right">
            <action id="ClaudeSessions.OpenSettings"
                    class="dev.andy.claudesessions.actions.OpenSettingsAction"
                    text="Claude Sessions Settings"
                    description="Background usage fetching and session status"
                    icon="AllIcons.General.Settings"/>
        </group>

        <!--
          Deliberately not on the toolbar: this is one-time setup, not something to reach for.
          Registered so it stays available from Find Action (Cmd+Shift+A).
        -->
        <action id="ClaudeSessions.ToggleHooks"
                class="dev.andy.claudesessions.actions.ToggleHooksAction"
                text="Claude Status Hooks"
                description="Report session status for every Claude entrypoint, not just terminal sessions"
                icon="AllIcons.General.Settings"/>
    </actions>
</idea-plugin>
